# ============================================================================
# Project Management App - kornyezeti valtozok
# ============================================================================
#
# Masold at `.env` nevre, es toltsd ki. A `[KOTELEZO]` jelzesu valtozok nelkul
# az API el sem indul: a Program.cs fail-fast modon kivetelt dob indulaskor.
# A tobbinek van alapertelmezese, de a megjegyzes leirja, mi tortenik nelkule.
#
# A frontend `VITE_*` valtozoi BUILD TIME erteket kapnak: a Vite beepiti oket a
# bundle-be, tehat atirasuk utan a frontend image-et UJRA KELL EPITENI.
#
# ============================================================================


# ---------------------------------------------------------------------------
# Adatbazis
# ---------------------------------------------------------------------------

# [KOTELEZO] Npgsql connection string. Fejlesztoi pelda:
#   Host=localhost;Port=5432;Database=projectmanager;Username=pmuser;Password=pmpassword
# Eles kornyezetben a Host a konteneren neve (pl. `postgres`), nem localhost.
DATABASE_URL=

# A postgres konteneren indulasahoz kell (docker-compose), nem a kod olvassa.
# A DATABASE_URL-ben szereplo ertekekkel kell egyeznie.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=


# ---------------------------------------------------------------------------
# Hitelesites es titkositas
# ---------------------------------------------------------------------------

# [KOTELEZO] A JWT alairo kulcsa. LEGALABB 32 BAJT - a Program.cs ennel
# rovidebb ertekkel meg sem indul (HMAC-SHA256 kulcsmeret).
#
# Generalashoz lasd az ENCRYPTION_KEY kommentjet (ugyanazok a parancsok). Itt a
# hossz csak also korlat, tehat a 48 bajtos valtozat is jo - sot ajanlott.
JWT_SECRET=

# [KOTELEZO] A tokenek kibocsatoja es cimzettje. Fejlesztoi pelda:
#   JWT_ISSUER=ProjectManager.API
#   JWT_AUDIENCE=ProjectManager.Client
JWT_ISSUER=
JWT_AUDIENCE=

# [KOTELEZO] Az access token elettartama percben (pl. 60).
# Ugyanezt az erteket kapja a frontend a VITE_JWT_ACCESS_TOKEN_LIFETIME-ban.
JWT_EXPIRY_MINUTES=

# [KOTELEZO] A refresh token elettartama percben (pl. 10080 = 7 nap).
JWT_REFRESH_TOKEN_LIFETIME=

# [KOTELEZO] A TOTP titkok es a webhook secretek AES-GCM kulcsa.
# PONTOSAN 32 bajt, base64-ben kodolva - ennel masra a szolgaltatas nem indul el.
# (A JWT_SECRET-tel ellentetben itt a 48 bajt NEM jo: a hossz ellenorzes egzakt.)
#
# Generalas - Git Bash / Linux / macOS:
#   openssl rand -base64 32
#
# Generalas - Windows PowerShell. Az openssl a Git for Windows resze, de nincs a
# PowerShell PATH-jan, ezert teljes utvonallal kell hivni (a & a call operator,
# az utvonalban levo szokoz miatt kell):
#   & "C:\Program Files\Git\mingw64\bin\openssl.exe" rand -base64 32
#
# Generalas - tiszta PowerShell, openssl nelkul:
#   $rng = [System.Security.Cryptography.RNGCryptoServiceProvider]::new()
#   $b = [byte[]]::new(32)
#   $rng.GetBytes($b)
#   [Convert]::ToBase64String($b)
#   $rng.Dispose()
#
# NE hasznalj Get-Random-ot: az determinisztikus PRNG (ugyanaz a mag ugyanazt a
# kimenetet adja), tehat a kulcs reprodukalhato. A RandomNumberGenerator::Fill
# pedig Windows PowerShell 5.1-en NEM letezik - a hivas hibat dob, a szkript
# viszont tovabb fut, es egy CSUPA NULLA "kulcsot" ir ki.
#
# FIGYELEM: ha ez az ertek elveszik vagy lecserelodik, a mar titkositott
# adatok visszafejthetetlenek - a 2FA-t minden felhasznalonak ujra kell kotnie.
ENCRYPTION_KEY=

# A refresh token suti domainje. Uresen hagyva host-only sutit ad, ami
# fejlesztoi kornyezetben a helyes viselkedes. Elesben a kozos domain
# (pl. `.trunkpeter.com`), hogy az app es az api aldomain is lassa.
COOKIE_DOMAIN=


# ---------------------------------------------------------------------------
# Redis - kereleskorlatozas es SignalR backplane
# ---------------------------------------------------------------------------

# Nelkule a kereleskorlatozas es a SignalR backplane nem mukodik. EGY backend
# peldannyal az alkalmazas elindul, de TOBB peldany eseten a valos ideju
# ertesitesek nem jutnak at a peldanyok kozott.
# Pelda:  redis:6379,password=<REDIS_PASSWORD>
REDIS_CONNECTION=

# A redis konteneren `--requirepass` erteke (docker-compose), nem a kod olvassa.
# A REDIS_CONNECTION password reszeben ugyanennek kell szerepelnie.
REDIS_PASSWORD=


# ---------------------------------------------------------------------------
# Fajltarolas (S3-kompatibilis objektumtarolo)
# ---------------------------------------------------------------------------

# [KOTELEZO] A tarolo belso cime, kulcsai es bucketje.
# A fejlesztoi ertekeket a docker-compose.yml tarolo-szolgaltatasa hatarozza meg.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# "true" eseten HTTPS-sel kapcsolodik a tarolohoz. Minden mas ertek = false.
S3_USE_SSL=

# A bongeszonek adott presigned URL-ek alapcime. Uresen hagyva a S3_ENDPOINT
# szerepel bennuk - ami a konteneren halozaton belul helyes, kifele viszont
# elerhetetlen. Elesben ezert kell a publikus cim.
S3_PUBLIC_URL=

# A feltoltheto fajl maximalis merete MB-ban. Alapertelmezes: 64
MAX_UPLOAD_SIZE_MB=


# ---------------------------------------------------------------------------
# E-mail kuldes (Resend)
# ---------------------------------------------------------------------------

# Nelkule az alkalmazas elindul, de NEM megy ki level: sem a regisztracios
# megerosito, sem a jelszo-visszaallito. Fejlesztoi kornyezetben uresen
# hagyhato, ha a megerositest kezzel allitod az adatbazisban.
RESEND_API_KEY=

# A kimeno levelek feladoja. Alapertelmezes: noreply@trunkpeter.com
EMAIL_FROM=


# ---------------------------------------------------------------------------
# Naplozas (OpenObserve)
# ---------------------------------------------------------------------------
# Ide kerul a `UserErasure` esemeny is, amire a GDPR visszaallitasi eljaras epul
# (lasd OPERATIONS.md) - eles kornyezetben ezert nem hagyhato figyelmen kivul.

# Az OTLP betoltesi vegpont. Az "default" a szervezet neve az OpenObserve-ben.
# Alapertelmezes (fejlesztoi):  http://localhost:5080/api/default/v1/logs
# Elesben a konteneren neve:    http://openobserve:5080/api/default/v1/logs
OTLP_LOGS_ENDPOINT=

# A betoltes hitelesitese. A Seq ezt NEM igenyelte, az OpenObserve igen.
#
# Szandekosan KULON betoltesre letrehozott felhasznalo, nem a root: igy az aggregator
# admin jelszava nem kerul az API konteneribe. A felhasznalot az OpenObserve feluleten
# kell letrehozni az elso inditas utan, es a tokenjet ide beirni.
#
# Ha ez a ketto ures, az alkalmazas ELINDUL, de a naplok nem jutnak el az aggregatorba -
# a konzolos log viszont megmarad (azt a Dokploy felulete mutatja).
OO_INGEST_USER=
OO_INGEST_TOKEN=

# Az openobserve konteneren ELSO indulasakor letrehozott root felhasznalo
# (docker-compose, nem a kod olvassa).
#
# MINDKETTO ERTEKE KOTOTT, es az OpenObserve indulaskor PANIKOL, ha nem felel meg
# (leellenorizve a v1.0.0 image-en, nem feltetelezes):
#   - OO_ROOT_USER_EMAIL: rendes domain kell, TLD-vel. A "dev@localhost" ELUTASITVA.
#   - OO_ROOT_USER_PASSWORD: 8-128 karakter, es kell bele kisbetu, NAGYBETU, szam
#     ES specialis karakter. Kulonben: "ZO_ROOT_USER_PASSWORD is too weak".
#
# FIGYELEM: a ZO_ROOT_USER_* csak ures adatkoteten ervenyesul - egy mar inicializalt
# peldany jelszavat a feluleten kell atirni.
OO_ROOT_USER_EMAIL=
OO_ROOT_USER_PASSWORD=


# ---------------------------------------------------------------------------
# Cimek es routing
# ---------------------------------------------------------------------------

# A frontend cime. A CORS engedelyezett origin-je es a levelekben szereplo
# linkek alapja. Alapertelmezes: http://localhost:5173
FRONTEND_URL=

# Az API publikus cime. Ebbol epul a webhook URL, amit a GitHub/GitLab
# beallitasahoz kimasolsz. Alapertelmezes: http://localhost:5178
# Lokalis webhook teszteleshez ez az ngrok tunnel cime (lasd README).
API_BASE_URL=

# A Traefik routing hoszt-nevei (docker-compose), nem a kod olvassa.
# Protokoll NELKUL, csak a domain: pl. api.pelda.hu
DOMAIN=
FRONTEND_DOMAIN=
S3_DOMAIN=


# ---------------------------------------------------------------------------
# Takarito hatterfeladatok
# ---------------------------------------------------------------------------
# Mindnek van alapertelmezese a kodban, de a megorzesi idoket az adatkezelesi
# tajekoztato nevesiti, ezert elesben erdemes explicit erteket adni.

# Az arva (meg nem erositett) feltoltesek takaritasanak periodusa. Alapertelmezes: 24
ORPHAN_CLEANUP_INTERVAL_HOURS=

# A token-takaritas periodusa orakban. Alapertelmezes: 6
TOKEN_CLEANUP_INTERVAL_HOURS=

# Lejart refresh tokenek megorzese a lejarat UTAN, napokban. Alapertelmezes: 30
REFRESH_TOKEN_RETENTION_DAYS=

# Megerositett feltoltesi naplosorok megorzese napokban. Alapertelmezes: 90
CONFIRMED_UPLOAD_LOG_RETENTION_DAYS=


# ---------------------------------------------------------------------------
# Frontend - BUILD TIME valtozok
# ---------------------------------------------------------------------------
# A Vite ezeket a bundle-be epiti, NEM futasidoben olvassa. Atirasuk utan a
# frontend image-et ujra kell epiteni - az env atirasa onmagaban nem eleg.

# Az API alapcime a bongeszobol nezve. Hianyaban a kod localhost:5178-ra esik vissza.
VITE_API_URL=

# A SignalR kezi keepalive. A Cloudflare proxy ~100 masodperc inaktivitas utan
# bontja a WebSocket kapcsolatot, ezert proxy mogott erdemes bekapcsolni.
# "true" eseten aktiv; a periodus masodpercben, a kod 5 es 30 koze szoritja.
VITE_SIGNALR_KEEPALIVE_ENABLED=
VITE_SIGNALR_KEEPALIVE_SECONDS=

# Az access token elettartama percben, a lejarat kijelzesehez a feluleten.
# A JWT_EXPIRY_MINUTES ertekevel kell egyeznie.
VITE_JWT_ACCESS_TOKEN_LIFETIME=


# ---------------------------------------------------------------------------
# Frontend - jogi dokumentumok adatai
# ---------------------------------------------------------------------------
# Az adatkezelesi tajekoztatoban es a felhasznalasi feltetelekben megjeleno adatok.
# Azert kornyezeti valtozok, hogy a repoba ne keruljon bele senkinek a neve es cime
# - igy sajat peldanyt barki futtathat a sajat adataival.
#
# Ezek NEM titkok: a VITE_* valtozok a bundle-be beepulnek, 
# es az adatkezelo azonosithatosaga jogszabalyi kovetelmeny (GDPR 13. cikk). 
# Ha ures marad, a dokumentumban feltuno "[KITOLTENDO: ...]" helyorzo latszik.
#
# FIGYELEM: build time valtozok - eles kornyezetben a beallitas utan a frontend
# image-et ujra kell epiteni, kulonben a helyorzo marad kint.
VITE_LEGAL_CONTROLLER_NAME=
VITE_LEGAL_CONTROLLER_ADDRESS=
VITE_LEGAL_CONTACT_EMAIL=
VITE_LEGAL_HOSTING_PROVIDER=
