# Takarito hatterfeladatok. Mindnek van alapertelmezese a kodban, de a megorzesi idoket
# az adatkezelesi tajekoztato nevesiti, ezert elesben erdemes explicit erteket adni.
ORPHAN_CLEANUP_INTERVAL_HOURS=
TOKEN_CLEANUP_INTERVAL_HOURS=
REFRESH_TOKEN_RETENTION_DAYS=
CONFIRMED_UPLOAD_LOG_RETENTION_DAYS=

# Az adatkezelesi tajekoztatoban es a felhasznalasi feltetelekben megjeleno adatok.
# Azert kornyezeti valtozok, hogy a repoba ne kerüljon bele senkinek a neve es cime -
# igy sajat peldanyt barki futtathat a sajat adataival.
# Ezek NEM titkok: a VITE_* valtozok a bundle-be beepulnek, es az adatkezelo
# azonosithatosaga jogszabalyi kovetelmeny. Ha ures marad, a dokumentumban
# feltuno "[KITOLTENDO: ...]" helyorzo latszik.
VITE_LEGAL_CONTROLLER_NAME=
VITE_LEGAL_CONTROLLER_ADDRESS=
VITE_LEGAL_CONTACT_EMAIL=
VITE_LEGAL_HOSTING_PROVIDER=